PORT=8787
APP_URL=https://free.helzerx.cyou
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://free.helzerx.cyou/api/auth/discord/callback
# Optional: require members to belong to this Discord server.
DISCORD_GUILD_ID=
ADMIN_REVIEW_KEY=replace-with-a-long-random-admin-review-key
# HZL hosting plans are hidden unless explicitly configured.
# Every provisionable plan needs a "proxmox" mapping: cores, memory (MB), disk (GB).
# Example: [{"id":"ubuntu-basic","service":"vps","name":"Ubuntu Basic LXC","description":"Ubuntu 24.04 LXC","cost":1200,"proxmox":{"cores":1,"memory":1024,"disk":8,"swap":512}}]
HOSTING_REDEMPTION_OPTIONS=[]
# Proxmox provisioning is OFF by default. Enable only after validating permissions,
# DHCP on vmbr0, and a dedicated VMID range. Never disable TLS verification.
PROXMOX_ENABLED=false
PROXMOX_API_URL=https://cvp.helzerx.cyou/api2/json
PROXMOX_NODE=hlx-infra-02
PROXMOX_STORAGE=local
PROXMOX_BRIDGE=vmbr0
PROXMOX_TEMPLATE=local:vztmpl/ubuntu-24.04-standard_24.04-2_amd64.tar.zst
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
# Public SSH key installed for root access inside provisioned containers. No passwords are stored.
PROXMOX_SSH_PUBLIC_KEYS=
# Provisioner only allocates VMIDs in this range. Set a range reserved for this app.
PROXMOX_VMID_MIN=2000
PROXMOX_VMID_MAX=2999
PROXMOX_TASK_TIMEOUT_MS=180000
PROXMOX_NETWORK=dhcp
